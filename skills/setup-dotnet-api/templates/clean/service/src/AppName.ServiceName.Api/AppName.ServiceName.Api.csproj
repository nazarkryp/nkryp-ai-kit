<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <!-- The Docker build sets the release version with -p:Version=$VERSION. -->
        <Version>0.0.0-dev</Version>
        <!-- The build writes src/openapi-servicename.json. Outside the project folder, it is not copied to the output. -->
        <OpenApiDocumentsDirectory>..</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--file-name openapi-servicename</OpenApiGenerateDocumentsOptions>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AppName.Api.Infrastructure\AppName.Api.Infrastructure.csproj" />
        <!-- @module:jwt -->
        <ProjectReference Include="..\AppName.Api.Authentication\AppName.Api.Authentication.csproj" />
        <!-- @end -->
        <ProjectReference Include="..\AppName.ServiceName.Api.Contracts\AppName.ServiceName.Api.Contracts.csproj" />
        <ProjectReference Include="..\AppName.Common\AppName.Common.csproj" />
        <ProjectReference Include="..\AppName.ServiceName.Application\AppName.ServiceName.Application.csproj" />
        <ProjectReference Include="..\AppName.ServiceName.Persistence\AppName.ServiceName.Persistence.csproj" />
        <!-- @module:auth -->
        <ProjectReference Include="..\AppName.ServiceName.Security\AppName.ServiceName.Security.csproj" />
        <!-- @end -->
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Http" />
        <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="Serilog.AspNetCore" />
    </ItemGroup>

</Project>
