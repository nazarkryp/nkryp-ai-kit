<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <!-- The Docker build sets the release version with -p:Version=$VERSION. -->
        <Version>0.0.0-dev</Version>
        <OpenApiDocumentsDirectory>..</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AppName.Common\AppName.Common.csproj" />
        <ProjectReference Include="..\AppName.Domain\AppName.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Http" />
        <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
        <PackageReference Include="MediatR" />
        <!-- @module:auth -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <!-- @end -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="Serilog.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AppName.UnitTests" />
    </ItemGroup>

</Project>
