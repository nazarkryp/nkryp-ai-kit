{
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4300"
    ]
  },
  "Collection": {
    "DefaultLimit": 24,
    "MaxLimit": 100
  },
  "OpenApiExamples": {},
  // @module:auth
  "Jwt": {
    "KeyId": "appname-key-v1",
    "Issuer": "https://localhost:7291",
    "Audience": "appname-api",
    "TokenType": "Bearer",
    "AccessTokenExpiresIn": "00:01:00",
    "RefreshTokenExpiresIn": "7.00:00:00",
    "SecretFile": "data/jwt-secret"
  },
  "CredentialsRateLimit": {
    "PermitLimit": 10,
    "Window": "00:01:00"
  },
  "AccountSettings": {
    "MinUsernameLength": 3,
    "MaxUsernameLength": 20,
    "UsernameRegexPattern": "^(?:[a-zA-Z][a-zA-Z0-9]*(?:[._][a-zA-Z0-9]+)*|[0-9]+[a-zA-Z][a-zA-Z0-9]*(?:[._][a-zA-Z0-9]+)*)$",
    "EmailAddressPattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
    // @module:signup
    "AllowUserRegistration": true,
    // @end
    // @module:!signup
    "AllowUserRegistration": false,
    // @end
    "BlockedWords": [
      "retard",
      "idiot",
      "moron",
      "loser",
      "stupid",
      "trash"
    ],
    "SystemUsernames": [
      "admin",
      "administrator",
      "root",
      "system",
      "support",
      "staff",
      "moderator",
      "mod",
      "owner",
      "operator",
      "service",
      "security"
    ]
  },
  "PasswordSettings": {
    "MinPasswordLength": 8,
    "MaxPasswordLength": 128,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true,
    "SpecialCharacters": "!@#$%^&*()-_=+[]{}|;:,.<>?",
    "DisallowUsernameInPassword": true,
    "DisallowEmailInPassword": true,
    "MaxConsecutiveCharacters": 3,
    "AllowWhitespace": false,
    "BlockedPasswords": [
      "password",
      "123456",
      "12345678",
      "123456789",
      "qwerty",
      "qwerty123",
      "admin",
      "welcome",
      "password123"
    ]
  },
  // @end
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
